+// ghidra-rs (decomp-ref.patch): one line of symbol attributes for `print map` with DECOMP_MAP_EXTRA
+static void printSymbolAttributes(const Symbol *sym,ostream &s)
+
+{
+  s << "attributes " << sym->getName() << " :";
+  if ((sym->getFlags() & Varnode::addrtied)!=0) s << " addrtied";
+  if (sym->isTypeLocked()) s << " typelock";
+  if (sym->isNameLocked()) s << " namelock";
+  if (sym->isThisPointer()) s << " this";
+  if (sym->getCategory() >= 0) s << " category " << dec << sym->getCategory() << ':' << sym->getCategoryIndex();
+  s << endl;
+}
