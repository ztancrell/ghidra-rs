+namespace ghidra {
+// ghidra-rs (rust/tools/decomp-ref.patch): the high variables of one `print raw`, numbered by
+// first appearance (Funcdata::printRaw resets the numbering), for stage S7
+static map<const HighVariable *,int4> rawHighIds;
+void rawHighReset(void) { rawHighIds.clear(); }
+static int4 rawHighNumber(const HighVariable *h) {
+  map<const HighVariable *,int4>::iterator iter = rawHighIds.find(h);
+  if (iter == rawHighIds.end())
+    iter = rawHighIds.insert(pair<const HighVariable *,int4>(h,(int4)rawHighIds.size())).first;
+  return (*iter).second;
+}
+}
